# Aqua Guard backend configuration.  Copy to ".env" (git-ignored) and edit.  Never commit ".env".

# --- Web / session security -----------------------------------------------------
# Long random string. If empty, one is generated and stored in database/.secret_key
AQUAGUARD_SECRET_KEY=
AQUAGUARD_HOST=127.0.0.1            # use 0.0.0.0 to reach the API from other devices on your network
AQUAGUARD_PORT=5000
# Browser origins allowed to call the API with cookies (comma separated). Add your dashboard URL.
AQUAGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Convenience for LAN access to the dev dashboard (allows any 10.x / 172.16-31.x / 192.168.x origin). Off by default.
AQUAGUARD_CORS_ALLOW_PRIVATE_LAN=false
AQUAGUARD_COOKIE_SECURE=false       # true when served over HTTPS
AQUAGUARD_SESSION_IDLE_MIN=60
AQUAGUARD_SESSION_ABS_HOURS=12

# --- First administrator (only used when the database has no admin) ---------------
AQUAGUARD_ADMIN_EMAIL=admin@aquaguard.com
# Leave empty to get a random one-time password printed at first start.
AQUAGUARD_ADMIN_PASSWORD=

# --- MQTT --------------------------------------------------------------------------
AQUAGUARD_MQTT_ENABLED=true
# DEVELOPMENT ONLY: public broker, no authentication, anyone can read or inject data.
AQUAGUARD_MQTT_HOST=broker.emqx.io
AQUAGUARD_MQTT_PORT=1883
AQUAGUARD_MQTT_USER=
AQUAGUARD_MQTT_PASSWORD=
AQUAGUARD_MQTT_TLS=false            # true for a private broker (port 8883)
AQUAGUARD_MQTT_CA_FILE=             # path to the broker CA certificate (PEM); empty = system CA store
AQUAGUARD_MQTT_TOPIC_PREFIX=waterleak/project001

# --- Connectivity thresholds (gateway publishes a heartbeat every 15 s) ---------------
AQUAGUARD_GATEWAY_HEARTBEAT_S=15
AQUAGUARD_GATEWAY_OFFLINE_S=45
AQUAGUARD_NODE_OFFLINE_S=30
AQUAGUARD_AUTH_NODE=1               # flow node whose volume is "total consumption" (inlet meter)

# --- Leak detection (see config.LeakConfig for the complete list) ------------------------
AQUAGUARD_LEAK_ABS_LPM=0.6
AQUAGUARD_LEAK_REL_PCT=15
AQUAGUARD_LEAK_SUSPECT_S=20
AQUAGUARD_LEAK_CONFIRM_S=60
